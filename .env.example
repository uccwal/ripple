# ---- LLM ----
# 비우면 LLM_MODE=offline 으로 동작 (규칙 기반 Agent, 숫자 계산은 동일). 키를 넣으면 Claude를 호출한다.
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-haiku-5-5
# 본선 튜닝: Impact Mapper만 Sonnet (claude-sonnet-5-5)
MODEL_IMPACT_MAPPER=claude-haiku-5-5
# LLM_MODE=offline 로 강제할 수 있다
LLM_MODE=

# ---- DB ----
# 비우면 저장소 루트의 SQLite(ripple.db)를 쓴다. docker-compose는 PostgreSQL을 주입한다.
DATABASE_URL=

# ---- 데이터 수집 API 키 (없으면 해당 수집기 건너뜀, 합성 시계열로 데모) ----
FRED_API_KEY=
ECOS_API_KEY=
DATA_GO_KR_API_KEY=

# ---- 헤지 규칙 기준값 (MVP 기본값) ----
HEDGE_FX_SHARE=0.30
HEDGE_SECTOR_SHARE=0.40
HEDGE_RATE_SHARE=0.25
